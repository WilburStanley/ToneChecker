# Tone Checker environment variables.
# Copy this file to .env and fill in your own values.
# Never commit .env.

# Base URL of any OpenAI-compatible provider.
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Your own API key from the provider. Keep it secret.
LLM_API_KEY=

# Model ID to use.
# OpenRouter free router: openrouter/free
LLM_MODEL=